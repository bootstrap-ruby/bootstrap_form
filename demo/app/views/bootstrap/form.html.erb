<h3>Client-side Validation</h3>

<%= form_with_source do %>
  <%= bootstrap_form_for @user, url: "/", validate: true, html: { id: "client_side_validation_form", class: "vstack gap-3" } do |form| %>
    <%= form.text_field :misc, id: "client_validation_name", label: "Name", value: "Mark Otto", required: true, wrapper_class: "form-field" %>
    <%= form.email_field :email, id: "client_validation_email", label: "Email address", value: "", required: true, wrapper_class: "form-field" %>
    <%= form.text_field :misc, id: "client_validation_username", label: "Username", prepend: "@", required: true, wrapper_class: "form-field" %>
    <%= form.select :status, [["California", "CA"], ["New York", "NY"]], { label: "State", prompt: "Choose...", required: true, wrapper_class: "form-field" }, { id: "client_validation_state" } %>
    <%= form.checkbox :terms, id: "client_validation_terms", label: "Agree to terms and conditions", required: true, wrapper_class: "form-field" %>
    <%= form.checkbox :remember_me, id: "client_validation_switch", label: "Subscribe to the newsletter", switch: true, required: true, wrapper_class: "form-field" %>
    <%= form.primary "Submit form", class: "btn-solid theme-primary align-self-start" %>
  <% end %>
<% end %>

<h3>Server-side Validation States</h3>

<%= form_with_source do %>
  <%= bootstrap_form_for @user_with_error, url: "/", html: { id: "server_side_validation_states_form" } do |form| %>
    <%= form.text_field :email, id: "server_validation_text", label: "Text input" %>
    <%= form.select :misc, @collection.map { |a| [a.street, a.id] }, { label: "Select" }, { id: "server_validation_select" } %>
    <%= form.checkbox :preferences, id: "server_validation_check", label: "Checkbox" %>
    <%= form.collection_radio_buttons :misc, @collection, :id, :street, id: "server_validation_radios", label: "Radios" %>
    <%= form.checkbox :preferences, id: "server_validation_switch", label: "Switch", switch: true %>
    <%= form.range_field :misc, id: "server_validation_range", label: "Range" %>
    <%= form.text_field :email, id: "server_validation_floating", label: "Floating label", floating: true %>
    <%= form.text_field :email, id: "server_validation_adorn", label: "Adorned input", adorn: { icon: tag.i(class: "bi bi-envelope") } %>
    <%= form.text_field :email, id: "server_validation_input_group", label: "Input group", prepend: "@" %>
    <%= form.file_field :misc, id: "server_validation_file", label: "File input" %>
    <%= form.otp_field :misc, id: "server_validation_otp", label: "OTP input", value: "123", otp: { class: "otp-connected" } %>
    <%= form.combobox :misc, @collection.map { |a| [a.street, a.id] }, id: "server_validation_combobox", label: "Combobox" %>
    <%= form.datepicker_field :misc, id: "server_validation_datepicker", label: "Datepicker", value: "" %>
    <%= form.submit %>
  <% end %>
<% end %>
